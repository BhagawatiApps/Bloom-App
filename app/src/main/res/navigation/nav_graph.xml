<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/Dashboard">

    <fragment
        android:id="@+id/Dashboard"
        android:name="com.example.bloomapp.Fragment.fragment_home"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_Dashboard_to_Insights"
            app:destination="@id/Insights" />
    </fragment>

    <fragment
        android:id="@+id/Insights"
        android:name="com.example.bloomapp.Fragment.fragment_Insights"
        android:label="fragment__insights"
        tools:layout="@layout/fragment__insights" />

    <fragment
        android:id="@+id/Learn"
        android:name="com.example.bloomapp.Fragment.fragment_Learn"
        android:label="fragment__learn"
        tools:layout="@layout/fragment__learn" />

    <fragment
        android:id="@+id/Settings"
        android:name="com.example.bloomapp.Fragment.fragment_Settings"
        android:label="fragment__settings"
        tools:layout="@layout/fragment__settings" />

</navigation>
