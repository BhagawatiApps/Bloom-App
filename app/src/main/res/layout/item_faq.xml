<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/_2sdp"
    android:padding="@dimen/_14sdp"
    android:background="@drawable/bg_faq_card">

    <TextView
        android:id="@+id/tvFaqTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="What exactly is PCOS?"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="@dimen/_14ssp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivFaqArrow"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFaqDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:text="PCOS stands for polycystic ovary syndrome..."
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="@dimen/_12ssp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivFaqArrow"
        app:layout_constraintTop_toBottomOf="@id/tvFaqTitle" />

    <ImageView
        android:id="@+id/ivFaqArrow"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:src="@drawable/ic_chevron_right"
        android:contentDescription="Open FAQ"
        app:tint="@color/md_theme_onSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
